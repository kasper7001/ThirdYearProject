[Unit]
Description=Suricata to MQTT alert publisher
After=network-online.target suricata.service
Wants=network-online.target
Requires=suricata.service

[Service]
Type=simple
User=root
# Ensure Suricata's eve.json exists before starting
ExecStartPre=/bin/sh -c 'test -f /var/log/suricata/eve.json || exit 1'
ExecStart=/usr/bin/python3 /opt/suri_mqtt_publisher.py
Restart=always
RestartSec=2
SyslogIdentifier=suri-mqtt-publisher

[Install]
WantedBy=multi-user.target
